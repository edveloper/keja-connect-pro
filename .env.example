# Copy to .env and fill in from Supabase dashboard > Project Settings > API.
# Anything prefixed VITE_ is compiled into the browser bundle. Never put a
# service-role key here — row-level security is what protects the data.

VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
